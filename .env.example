# ============================================================================
# URJASAATHI – PRODUCTION ENVIRONMENT VARIABLES (SERVER & BROWSER)
# ============================================================================
# SECURITY RULE:
# - Keep SUPABASE_SERVICE_ROLE_KEY, URJASAATHI_SESSION_SECRET, and GEMINI_API_KEY
#   strictly on the Node.js server. Never expose them in VITE_ variables or client code.
# - Only the public anon key (VITE_SUPABASE_ANON_KEY) may be used in frontend code.

# ----------------------------------------------------------------------------
# 1. SERVER-ONLY ENVIRONMENT VARIABLES (Node.js / Vercel Serverless Backend)
# ----------------------------------------------------------------------------

# SUPABASE_URL: Existing Supabase project URL
SUPABASE_URL="https://wzkpbofwajdbaqqrviqw.supabase.co"

# SUPABASE_SERVICE_ROLE_KEY: Server-side privileged key used ONLY by the Node.js backend
# (/api/missions/*, /api/passport/*, /api/user/*) to verify JWTs and run atomic RPCs.
# NEVER expose this key in frontend bundles or VITE_ variables.
SUPABASE_SERVICE_ROLE_KEY=""

# URJASAATHI_SESSION_SECRET: Server-side HMAC-SHA256 secret (32+ bytes) used to sign
# fallback session tokens and Green Impact Passport cryptographic payload hashes.
URJASAATHI_SESSION_SECRET=""

# GEMINI_API_KEY: Platform-managed Gemini API key used by the server (/api/gemini/*)
# so signed-in users access UrjaGuru AI automatically without ever entering API keys.
GEMINI_API_KEY=""

# APP_BASE_URL: Canonical production HTTPS domain used to generate public QR verification links
# (e.g., https://urjasaathi-mission-life.vercel.app).
APP_BASE_URL="https://YOUR-DEPLOYED-DOMAIN"
APP_URL=""

# ----------------------------------------------------------------------------
# 2. FRONTEND / BROWSER ENVIRONMENT VARIABLES (Public Only)
# ----------------------------------------------------------------------------

# VITE_SUPABASE_URL: Public Supabase project URL for browser PKCE OAuth login
VITE_SUPABASE_URL="https://wzkpbofwajdbaqqrviqw.supabase.co"

# VITE_SUPABASE_ANON_KEY: Public anonymous key (role="anon") used by the browser
# for supabase.auth.signInWithOAuth() and PKCE session exchange.
VITE_SUPABASE_ANON_KEY=""

# Optional server alias for public anon key if injected via /api/auth/public-config
SUPABASE_ANON_KEY=""

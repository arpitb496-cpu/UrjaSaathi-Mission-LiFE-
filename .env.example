# GEMINI_API_KEY: Required for UrjaGuru Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_BASE_URL: Canonical deployed HTTPS domain used to generate public QR verification links
# (e.g., https://your-deployed-domain.vercel.app). Never hardcode localhost in production.
APP_BASE_URL="https://YOUR-DEPLOYED-DOMAIN"
APP_URL="MY_APP_URL"

# ============================================================================
# SUPABASE POSTGRESQL PRODUCTION PERSISTENCE (Required for Vercel Deployment)
# ============================================================================
# If SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are not configured, URJASAATHI
# will explicitly report that persistent production storage is unavailable and
# operate in Local Demo Fallback mode with a visible persistence limitation notice.

# SUPABASE_URL: Your Supabase project URL (e.g., https://<project-ref>.supabase.co)
SUPABASE_URL=""

# SUPABASE_SERVICE_ROLE_KEY: Server-side secret key used ONLY by backend API routes
# (/api/missions/*, /api/passport/*) to execute atomic transactions. Never expose to client.
SUPABASE_SERVICE_ROLE_KEY=""

# SUPABASE_ANON_KEY: Optional public anon key for client-side Supabase Auth token exchange.
SUPABASE_ANON_KEY=""

# URJASAATHI_SESSION_SECRET: Server-side HMAC secret used to sign and verify HttpOnly
# user session tokens and Green Impact Passport QR credential hashes when anonymous
# or cookie-bound sessions are used. Replace with a 32+ byte random hex string in production.
URJASAATHI_SESSION_SECRET=""

# ============================================================================
# URJASAATHI – VERCEL PRODUCTION ENVIRONMENT VARIABLES
# ============================================================================
# Never expose secret keys in client-side code or VITE_ variables.
# Configure all variables below in the Vercel Project Settings -> Environment Variables.

# GEMINI_API_KEY: Server-side API key for UrjaGuru Gemini AI endpoints (/api/gemini/chat, /api/gemini/coach).
GEMINI_API_KEY=""

# APP_BASE_URL: Canonical production HTTPS domain used to generate public QR verification links
# (e.g., https://urjasaathi-mission-life.vercel.app). Never use localhost in production.
# If omitted on Vercel, URJASAATHI automatically falls back to https://$VERCEL_PROJECT_PRODUCTION_URL.
APP_BASE_URL="https://YOUR-DEPLOYED-DOMAIN"
APP_URL=""

# ============================================================================
# SUPABASE POSTGRESQL PRODUCTION PERSISTENCE (Required for Vercel Deployment)
# ============================================================================
# If SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are not configured, URJASAATHI
# will explicitly report that persistent production storage is unavailable and
# operate in Local Demo Fallback mode with a visible persistence limitation notice.

# SUPABASE_URL: Your Supabase project URL (e.g., https://<project-ref>.supabase.co)
SUPABASE_URL=""

# SUPABASE_SERVICE_ROLE_KEY: Server-side secret key used ONLY by backend API routes
# (/api/missions/*, /api/passport/*) to execute atomic transactions. Never expose to client.
SUPABASE_SERVICE_ROLE_KEY=""

# SUPABASE_ANON_KEY: Optional public anon key for client-side Supabase Auth token exchange.
SUPABASE_ANON_KEY=""

# URJASAATHI_SESSION_SECRET: Server-side HMAC-SHA256 secret (32+ bytes) used to sign and verify
# HttpOnly user session tokens and Green Impact Passport QR credential hashes.
URJASAATHI_SESSION_SECRET=""

